# ─── PIXO Therapy ─── Configuración vía variables de entorno ────
# Copia este archivo como .env y ajusta los valores si es necesario.
# docker compose up --build  detectará automáticamente .env

# Secreto para sesiones Flask (cámbialo en producción)
SECRET_KEY=change-me-in-production

# Depuración (0=off, 1=on)
FLASK_DEBUG=0

# Hosts de la base de datos (postgres = nombre del servicio en docker-compose)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mario_db
DB_USER=postgres
DB_PASSWORD=admin
